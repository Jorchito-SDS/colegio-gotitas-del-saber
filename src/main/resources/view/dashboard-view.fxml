<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #0d1322;" stylesheets="@../css/global-styles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.DashboardController">
   <children>
      <Label style="-fx-font-size: 20px;" text="Gestión de Estudiantes" />

      <!-- Formulario Horizontal -->
      <GridPane hgap="10.0" vgap="10.0">
         <children>
            <Label text="ID Estudiante:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtIdEstudiante" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Nombre:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtApellido" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Correo Electrónico:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="1" />
         </children>
      </GridPane>

      <!-- Botones de Acción -->
      <HBox spacing="10.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#handleGuardar" text="Guardar" />
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#handleActualizar" text="Actualizar" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#handleEliminar" style="-fx-background-color: #e74c3c;" text="Eliminar" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#handleLimpiar" style="-fx-background-color: #95a5a6;" text="Limpiar" />
         </children>
      </HBox>

      <!-- Tabla de Estudiantes -->
      <TableView fx:id="tvEstudiante" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="tvColumnIdEstudiante" prefWidth="100.0" text="ID" />
          <TableColumn fx:id="tvColumnNombreEstudiante" prefWidth="120.0" text="Nombre" />
          <TableColumn fx:id="tvColumnApellidoEstudiante" prefWidth="120.0" text="Apellido" />
          <TableColumn fx:id="tvColumnCorreo" prefWidth="160.0" text="Correo Electrónico" />
          <TableColumn fx:id="tvColumnSeccion" prefWidth="90.0" text="Sección" />
          <TableColumn fx:id="tvColumnCurso" prefWidth="110.0" text="Curso" />
          <TableColumn fx:id="tvColumnNombreDocente" prefWidth="110.0" text="Nombre Docente" />
          <TableColumn fx:id="tvColumnApellidoDocente" prefWidth="110.0" text="Apellido Docente" />
        </columns>
      </TableView>
   </children>
</VBox>