<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="600.0" prefWidth="900.0" stylesheets="@../CSS/global-styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.MainLayoutController">
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: #0d1322; -fx-border-color: #1e293b; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="lblBienvenida" text="Bienvenido Master" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </Label>
         </children>
      </HBox>
   </top>
   <left>
      <VBox prefWidth="200.0" spacing="15.0" style="-fx-background-color: #0d1322; -fx-border-color: #1e293b; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Menú de opciones:" textFill="#38bdf8">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Label>
            <Button fx:id="btnEstudiantes" maxWidth="1.7976931348623157E308" onAction="#handleMostrarEstudiantes" text="Tabla Estudiantes" />
            <Button fx:id="btnDocentes" maxWidth="1.7976931348623157E308" onAction="#handleMostrarDocentes" text="Tabla Docentes" />
            <Button fx:id="btnMatriculas" maxWidth="1.7976931348623157E308" onAction="#handleMostrarMatriculas" text="Tabla Matrículas" />
            <VBox VBox.vgrow="ALWAYS" />
            <Button fx:id="btnCerrarSesion" maxWidth="1.7976931348623157E308" onAction="#handleCerrarSesion" style="-fx-background-color: #e74c3c;" text="Cerrar Sesión" />
         </children>
         <padding>
            <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" style="-fx-background-color: #060913;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Selecciona una opción del menú lateral" textFill="#64748b">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <ImageView fitHeight="541.0" fitWidth="707.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/88532445-programming-code-abstract-technology-background-of-software-developer-and-computer-script.jpg" />
               </image>
            </ImageView>
         </children>
      </StackPane>
   </center>
</BorderPane>
