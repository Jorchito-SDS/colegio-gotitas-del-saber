<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" style="-fx-padding: 20; -fx-background-color: #0d1322;" stylesheets="@../css/global-styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.edu.ingsoft.colegio.gotitas.controller.MatriculaController">
      
    <Label style="-fx-font-size: 20px; -fx-text-fill: white;" text="Gestión de Matrículas" />

    <!-- Formulario para ingresar los datos -->
    <VBox spacing="10.0" style="-fx-background-color: #161f36; -fx-padding: 15; -fx-background-radius: 8;">
        <TextField fx:id="txtIdMatricula" promptText="ID Matrícula (Ej. M01)" />
        <TextField fx:id="txtIdEstudiante" promptText="ID Estudiante (Ej. 123)" />
        <TextField fx:id="txtIdSeccion" promptText="ID Sección (Ej. SEC-01)" />
        
        <HBox spacing="10.0">
            <Button onAction="#handleGuardarMatricula" style="-fx-background-color: #4e73df; -fx-text-fill: white;" text="Guardar" />
            <Button fx:id="btnActualizar" onAction="#handleActualizar" style="-fx-background-color: #1cc88a; -fx-text-fill: white;" text="Actualizar Lista" />
        </HBox>
    </VBox>

    <TableView fx:id="tblMatriculas" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdMatricula" prefWidth="150" text="ID Matrícula" />
            <TableColumn fx:id="colEstudiante" prefWidth="250" text="Estudiante" />
            <TableColumn fx:id="colSeccion" prefWidth="180" text="Sección" />
        </columns>
    </TableView>
</VBox>